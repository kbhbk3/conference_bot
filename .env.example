# Скопируйте этот файл в .env и впишите свои значения. Файл .env никому не показывайте.

# 1. Токен бота от @BotFather (обязательно)
TELEGRAM_TOKEN=

# 2. Нейросеть — необязательно. Подходит любой OpenAI-совместимый API.
#    Раскомментируйте один из вариантов.
#
#    Вариант А — YandexGPT (Yandex AI Studio, оплата в рублях).
#    <ID_каталога> возьмите в консоли Yandex Cloud; ключ — секрет API-ключа
#    сервисного аккаунта. Актуальные названия моделей — в документации AI Studio.
# LLM_API_KEY=
# LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
# LLM_PROJECT=<ID_каталога>
# LLM_MODEL=gpt://<ID_каталога>/yandexgpt-5-lite
#
#    Вариант Б — DeepSeek (оплата в долларах):
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash

# 3. Кому разрешено пользоваться ботом (ваш chat id; бот подскажет его на /start).
#    Пусто — пользоваться может кто угодно, и тратить ваш ключ нейросети тоже.
ALLOWED_CHAT_IDS=

# 4. Расписание сводки
DIGEST_DAY=пн
DIGEST_TIME=10:00
TIMEZONE=Europe/Moscow

# 5. Тонкая настройка
MIN_RELEVANCE=6
COLLECT_EVERY_HOURS=4
RSS_URLS=https://konferencii.ru/rss
DB_PATH=conferences.db
